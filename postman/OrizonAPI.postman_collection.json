            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Risposta HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Il cliente aggiornato ha i dati attesi', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('customerId')));",
                  "  pm.expect(body.cognome).to.eql('PostmanMod');",
