                "type": "text/javascript",
                "exec": [
                  "pm.test('Risposta HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('La risposta è un array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
