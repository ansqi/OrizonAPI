        {
          "name": "POST - Crea cliente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.variables.replaceIn('{{$guid}}').replace(/-/g, '').slice(0, 8);",
                  "pm.collectionVariables.set('runToken', token);",
                  "pm.collectionVariables.set('customerName', 'QA' + token);",
                  "pm.collectionVariables.set('customerEmail', 'postman+' + token + '@example.com');",
                  "pm.collectionVariables.set('productName', 'Product' + token);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Risposta HTTP 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Il cliente creato contiene un ID e i dati inviati', function () {",
                  "  pm.expect(body.id).to.be.a('number');",
                  "  pm.expect(body.nome).to.eql(pm.collectionVariables.get('customerName'));",
                  "  pm.expect(body.email).to.eql(pm.collectionVariables.get('customerEmail'));",
                  "});",
                  "pm.collectionVariables.set('customerId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{customerName}}\",\n  \"cognome\": \"Postman\",\n  \"email\": \"{{customerEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers"
              ]
            }
          },
          "response": []
        },
        {
          "name": "PUT - Aggiorna cliente",
